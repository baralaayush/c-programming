//Write a c-program to read name, age and GPA of student from user and store it into file name student.txt
#include<stdio.h>
#include<stdlib.h>
int main()
{
int age;
char name[50];
float GPA;
FILE *p;
p= fopen("student.txt","w"); //for opening file
int i,n;
printf("Enter no.of student");
scanf("%d",&n);
printf("Enter Details:\n");
for( i=0; i<n; i++)
{
printf("Enter name:");
scanf("%50[^\n]s",name);
printf("Enter age:");
scanf("%d",&age);
printf("Enter GPA:");
scanf("%f", &GPA);
fprintf(p,"Name is %s Age is %d GPA is %f,",name, age, GPA);
}
printf("Wrote successfully");
fclose(p);
return 0;
}

